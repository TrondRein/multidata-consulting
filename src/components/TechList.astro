---
const technologies = [
  "Microsoft Entra ID",
  "Microsoft Intune",
  "Microsoft 365",
  "Active Directory",
  "Hybrid identity",
  "Conditional Access",
  "Zero Trust",
  "Autopilot",
  "Defender",
  "Exchange Online",
  "SharePoint",
  "Teams",
  "Azure Virtual Desktop",
  "Windows 365",
  "PowerShell",
  "Automatisering",
];
---
<section id="teknologi" class="bg-brand-blue py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-3 h-1 w-10 rounded-full bg-brand-accent"></div>
    <h2 class="mb-8 text-3xl font-black text-white sm:text-4xl">Teknologier vi jobber med</h2>
    <div class="flex flex-wrap gap-3">
      {technologies.map((item) => (
        <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-slate-100 transition-all duration-150 hover:border-brand-accent hover:bg-brand-accent hover:text-white cursor-default">{item}</span>
      ))}
    </div>
  </div>
</section>
