---
---
<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="inline-flex items-center">
      <img src="/logo.png" alt="Multidata Consulting" class="h-20 w-auto" style="mix-blend-mode: multiply" />
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      <a href="#for-ledere" class="text-sm font-medium text-slate-700 hover:text-brand-blue">For ledere</a>
      <a href="#tjenester" class="text-sm font-medium text-slate-700 hover:text-brand-blue">For IT-ansvarlige</a>
      <a href="#prosess" class="text-sm font-medium text-slate-700 hover:text-brand-blue">Metodikk</a>
      <a href="#kontakt" class="inline-flex items-center rounded-lg bg-brand-blue px-4 py-2 text-sm font-semibold text-white hover:opacity-90">
        Kontakt oss
      </a>
    </nav>

    <button
      id="menu-btn"
      aria-label="Åpne meny"
      aria-expanded="false"
      class="inline-flex items-center justify-center rounded-md p-2 text-slate-700 hover:bg-slate-100 md:hidden"
    >
      <svg id="icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-4 pb-4 pt-2 md:hidden">
    <a href="#for-ledere" class="mobile-link block py-2 text-sm font-medium text-slate-700 hover:text-brand-blue">For ledere</a>
    <a href="#tjenester" class="mobile-link block py-2 text-sm font-medium text-slate-700 hover:text-brand-blue">For IT-ansvarlige</a>
    <a href="#prosess" class="mobile-link block py-2 text-sm font-medium text-slate-700 hover:text-brand-blue">Metodikk</a>
    <a href="#kontakt" class="mobile-link mt-2 block rounded-lg bg-brand-blue px-4 py-2 text-center text-sm font-semibold text-white hover:opacity-90">
      Kontakt oss
    </a>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconOpen = document.getElementById('icon-open')!;
  const iconClose = document.getElementById('icon-close')!;

  btn.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
    iconOpen.classList.toggle('hidden', !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
  });

  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
    });
  });
</script>
