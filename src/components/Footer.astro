---
import type { FooterContent } from '../lib/content/types';

interface Props {
  content: FooterContent;
}

const { content } = Astro.props;
---

<footer id="kontakt" class="bg-neutral-dark text-slate-400 py-16 px-6 md:px-12 mt-auto border-t border-slate-800">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-start gap-12">
    <div>
      <h3 class="text-white font-bold text-xl mb-4">{content.title}</h3>
      <p class="max-w-md text-sm leading-relaxed text-slate-400">{content.description}</p>
      <a href={`mailto:${content.email}`} class="inline-block text-brand-orange font-bold text-lg mt-4 hover:underline">
        {content.email}
      </a>
    </div>
    <div class="text-xs font-mono text-slate-500">
      <p>{content.location}</p>
      <p class="mt-4">{content.copyright}</p>
    </div>
  </div>
</footer>
