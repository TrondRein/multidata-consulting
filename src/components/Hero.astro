---
import type { HeroContent } from '../lib/content/types';

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;
---

<section class="relative bg-brand-blue text-white py-24 px-6 md:px-12 overflow-hidden border-b border-white/5">
  <div class="absolute inset-0 opacity-5 bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:32px_32px]"></div>
  <div class="max-w-6xl mx-auto relative z-10 grid gap-12 items-center md:grid-cols-2">
    <div>
      <h1 class="text-4xl md:text-6xl font-black tracking-tight mb-6 leading-tight">
        {content.title} <span class="text-brand-orange">{content.highlight}</span>
      </h1>
      <p class="text-lg md:text-xl text-slate-300 mb-10 leading-relaxed">
        {content.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href={content.primaryCta.href} class="bg-brand-orange hover:bg-brand-accent text-brand-blue font-bold px-8 py-4 rounded-xl transition-colors shadow-lg shadow-brand-orange/10">
          {content.primaryCta.label}
        </a>
        <a href={content.secondaryCta.href} class="border border-white/20 hover:bg-white/5 font-medium px-8 py-4 rounded-xl transition-colors backdrop-blur-sm">
          {content.secondaryCta.label}
        </a>
      </div>
    </div>
    {content.imageUrl && (
      <img
        src={content.imageUrl}
        alt={content.imageAlt || content.title}
        class="w-full h-[320px] md:h-[420px] rounded-2xl object-cover border border-white/10 shadow-2xl shadow-brand-blue/40"
        loading="eager"
      />
    )}
  </div>
</section>
