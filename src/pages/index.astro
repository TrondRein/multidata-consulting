---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StrategicValue from '../components/StrategicValue.astro';
import WhyUs from '../components/WhyUs.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import TechList from '../components/TechList.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Multidata Consulting | Senior Microsoft-konsulenter"
  description="Vi hjelper virksomheter med å ta full kontroll over sin Microsoft-plattform — fra strategi og arkitektur til implementering, sikkerhet og videreutvikling."
  canonical="https://multidataconsulting.no/"
>
  <Header />
  <main>
    <Hero />
    <StrategicValue />
    <WhyUs />
    <Services />
    <Process />
    <TechList />
  </main>
  <Footer />
</BaseLayout>
