---
const technologies = [
  "Microsoft Entra ID",
  "Microsoft Intune",
  "Microsoft 365",
  "Active Directory",
  "Hybrid identity",
  "Conditional Access",
  "Zero Trust",
  "Autopilot",
  "Defender",
  "Exchange Online",
  "SharePoint",
  "Teams",
  "Azure Virtual Desktop",
  "Windows 365",
  "PowerShell",
  "Automatisering",
];
---
<section id="teknologi" class="bg-slate-100 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-black text-brand-blue sm:text-4xl">Teknologier vi jobber med</h2>
    <div class="mt-8 flex flex-wrap gap-3">
      {technologies.map((item) => (
        <span class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700">{item}</span>
      ))}
    </div>
  </div>
</section>
